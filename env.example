# ============================================
# EstiDash Frontend Environment Variables
# Copy this file to .env.local for local development
# ============================================

# Backend API URL
# For local development: http://localhost:8000/api/v1
# For production: http://<EC2_IP>:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Node environment
NODE_ENV=development

# ── Logging (Phase 11.12 K1) ────────────────────────────────────────────
# Both optional. Defaults are deliberately quiet: any environment that is
# not NODE_ENV=development logs warnings and errors only, and never logs
# request/response or Redux payloads. Set these by hand to make a
# staging environment verbose for a specific debugging session.
#
# NEXT_PUBLIC_LOG_LEVEL   debug | info | warn | error   (default: debug in
#                         development, warn everywhere else)
# NEXT_PUBLIC_LOG_PAYLOADS  true | false  — renders the `data` argument of
#                         each log line, including API response bodies and
#                         Redux action payloads. Leave false outside local
#                         development: these carry contractor contact
#                         details and business identifiers.
# NEXT_PUBLIC_LOG_LEVEL=warn
# NEXT_PUBLIC_LOG_PAYLOADS=false
